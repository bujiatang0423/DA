{
  "components": {
    "schemas": {
      "BacktestRequest": {
        "additionalProperties": false,
        "properties": {
          "buy_slippage_bps": {
            "default": 10,
            "minimum": 0.0,
            "title": "Buy Slippage Bps",
            "type": "integer"
          },
          "end_date": {
            "format": "date",
            "title": "End Date",
            "type": "string"
          },
          "fee_schedule_version": {
            "default": "research-cn-a-2023-08-28",
            "title": "Fee Schedule Version",
            "type": "string"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/StrategyGroup"
            },
            "minItems": 1,
            "title": "Groups",
            "type": "array"
          },
          "initial_cash": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Initial Cash"
          },
          "sell_slippage_bps": {
            "default": 10,
            "minimum": 0.0,
            "title": "Sell Slippage Bps",
            "type": "integer"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "strategy_version": {
            "title": "Strategy Version",
            "type": "string"
          }
        },
        "required": [
          "strategy_version",
          "start_date",
          "end_date",
          "initial_cash",
          "groups"
        ],
        "title": "BacktestRequest",
        "type": "object"
      },
      "CandidateSubmitRequest": {
        "additionalProperties": false,
        "properties": {
          "as_of_time": {
            "format": "date-time",
            "title": "As Of Time",
            "type": "string"
          }
        },
        "required": [
          "as_of_time"
        ],
        "title": "CandidateSubmitRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HoldingAnalysisRequest": {
        "additionalProperties": false,
        "properties": {
          "as_of_time": {
            "format": "date-time",
            "title": "As Of Time",
            "type": "string"
          },
          "atr14": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ]
            },
            "title": "Atr14",
            "type": "object"
          },
          "market_max_exposure": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "1",
            "title": "Market Max Exposure"
          },
          "portfolio_drawdown": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0",
            "title": "Portfolio Drawdown"
          },
          "portfolio_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Portfolio Id",
            "type": "string"
          },
          "prices": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ]
            },
            "title": "Prices",
            "type": "object"
          }
        },
        "required": [
          "portfolio_id",
          "as_of_time"
        ],
        "title": "HoldingAnalysisRequest",
        "type": "object"
      },
      "HoldingAnalysisResponse": {
        "additionalProperties": false,
        "properties": {
          "as_of_time": {
            "format": "date-time",
            "title": "As Of Time",
            "type": "string"
          },
          "equity": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Equity",
            "type": "string"
          },
          "exposure_ratio": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Exposure Ratio",
            "type": "string"
          },
          "gross_exposure": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Gross Exposure",
            "type": "string"
          },
          "market_max_exposure": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Market Max Exposure",
            "type": "string"
          },
          "portfolio_drawdown": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Portfolio Drawdown",
            "type": "string"
          },
          "portfolio_id": {
            "title": "Portfolio Id",
            "type": "string"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/HoldingRisk"
            },
            "title": "Risks",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "portfolio_id",
          "as_of_time",
          "equity",
          "gross_exposure",
          "exposure_ratio",
          "market_max_exposure",
          "portfolio_drawdown",
          "risks",
          "warnings"
        ],
        "title": "HoldingAnalysisResponse",
        "type": "object"
      },
      "HoldingRisk": {
        "additionalProperties": false,
        "properties": {
          "average_cost": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Average Cost",
            "type": "string"
          },
          "drawdown_from_high": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Drawdown From High"
          },
          "effective_stop": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Stop"
          },
          "highest_close": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Highest Close"
          },
          "last_price": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Price"
          },
          "market_value": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Market Value",
            "type": "string"
          },
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "risk_status": {
            "title": "Risk Status",
            "type": "string"
          },
          "security_id": {
            "title": "Security Id",
            "type": "string"
          },
          "stop_breached": {
            "title": "Stop Breached",
            "type": "boolean"
          },
          "strategy_book": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strategy Book"
          },
          "unrealized_pnl": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unrealized Pnl"
          },
          "unrealized_return": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unrealized Return"
          }
        },
        "required": [
          "security_id",
          "origin",
          "quantity",
          "average_cost",
          "last_price",
          "market_value",
          "unrealized_pnl",
          "unrealized_return",
          "highest_close",
          "drawdown_from_high",
          "effective_stop",
          "stop_breached",
          "risk_status",
          "reasons"
        ],
        "title": "HoldingRisk",
        "type": "object"
      },
      "Page_RunDetail_": {
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunDetail"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items"
        ],
        "title": "Page[RunDetail]",
        "type": "object"
      },
      "RunDetail": {
        "additionalProperties": false,
        "properties": {
          "auto_trade_enabled": {
            "const": false,
            "default": false,
            "title": "Auto Trade Enabled",
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "heartbeat_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heartbeat At"
          },
          "human_confirm_required": {
            "const": true,
            "default": true,
            "title": "Human Confirm Required",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/RunKind"
          },
          "links": {
            "$ref": "#/components/schemas/RunLinks"
          },
          "progress": {
            "default": 0,
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "integer"
          },
          "run_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "kind",
          "status",
          "submitted_at",
          "links"
        ],
        "title": "RunDetail",
        "type": "object"
      },
      "RunKind": {
        "enum": [
          "candidate_recommendation",
          "holding_analysis",
          "backtest",
          "legacy_import"
        ],
        "title": "RunKind",
        "type": "string"
      },
      "RunLinks": {
        "additionalProperties": false,
        "properties": {
          "artifacts": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifacts"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "self": {
            "title": "Self",
            "type": "string"
          }
        },
        "required": [
          "self"
        ],
        "title": "RunLinks",
        "type": "object"
      },
      "RunRef": {
        "additionalProperties": false,
        "properties": {
          "auto_trade_enabled": {
            "const": false,
            "default": false,
            "title": "Auto Trade Enabled",
            "type": "boolean"
          },
          "human_confirm_required": {
            "const": true,
            "default": true,
            "title": "Human Confirm Required",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/RunKind"
          },
          "links": {
            "$ref": "#/components/schemas/RunLinks"
          },
          "run_id": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "kind",
          "status",
          "submitted_at",
          "links"
        ],
        "title": "RunRef",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "StrategyGroup": {
        "enum": [
          "A",
          "B",
          "C",
          "D"
        ],
        "title": "StrategyGroup",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DA Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/backtests": {
      "post": {
        "operationId": "submit_backtest_api_v1_backtests_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BacktestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunRef"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Backtest",
        "tags": [
          "backtests"
        ]
      }
    },
